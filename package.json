{
  "name": "track-now-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace=app run dev",
    "dev:landing": "npm --workspace=landing run dev",
    "dev:app": "npm --workspace=app run dev",
    "build": "npm run build:landing && npm run build:app",
    "build:landing": "npm --workspace=landing run build",
    "build:app": "npm --workspace=app run build",
    "typecheck": "npm --workspace=landing run typecheck && npm --workspace=app run typecheck",
    "test": "npm --workspace=app run test",
    "test:app": "npm --workspace=app run test",
    "preview:landing": "npm --workspace=landing run preview",
    "preview:app": "npm --workspace=app run preview"
  },
  "devDependencies": {
    "typescript": "~5.6.3"
  }
}
