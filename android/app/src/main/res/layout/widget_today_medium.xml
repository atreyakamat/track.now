<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_medium_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_background">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/widget_medium_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TRACK.NOW · TODAY"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#C8F169"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/widget_medium_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 7d streak"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Progress Stats -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/widget_medium_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="3 of 5 tasks completed (60%)"
            android:textSize="12sp"
            android:textColor="#CCCCCC" />

        <TextView
            android:id="@+id/widget_medium_timestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Updated 09:30"
            android:textSize="10sp"
            android:textColor="#777777" />
    </LinearLayout>

    <!-- Task List (Top 3 items) -->
    <LinearLayout
        android:id="@+id/widget_item_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/widget_item_1_bullet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="○ "
            android:textSize="13sp"
            android:textColor="#C8F169" />

        <TextView
            android:id="@+id/widget_item_1_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Morning 5km Run"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_item_1_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="08:00"
            android:textSize="10sp"
            android:textColor="#888888" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_item_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/widget_item_2_bullet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="○ "
            android:textSize="13sp"
            android:textColor="#C8F169" />

        <TextView
            android:id="@+id/widget_item_2_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Code Review & PRs"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_item_2_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="11:30"
            android:textSize="10sp"
            android:textColor="#888888" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_item_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/widget_item_3_bullet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="○ "
            android:textSize="13sp"
            android:textColor="#C8F169" />

        <TextView
            android:id="@+id/widget_item_3_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Read 20 pages book"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_item_3_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Habit"
            android:textSize="10sp"
            android:textColor="#888888" />
    </LinearLayout>

</LinearLayout>
