# Copy to apps/app/.env.local and fill in (Vite reads env files from apps/app, not the repo root).
# Only the public anon key belongs here.
# Never put the Supabase service_role key in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Optional: public app origin used in emailed links (required for native shells).
# VITE_APP_URL=https://trackapp.atreyakamat.dev
