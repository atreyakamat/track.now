# Copy to .env.local and fill in. Only the public anon key belongs here.
# Never put the Supabase service_role key in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional. Store page of the Android app. When set, Settings links to it for reminders that
# fire while the app is closed. Leave unset until the listing is live.
# VITE_ANDROID_APP_URL=https://play.google.com/store/apps/details?id=dev.atreyakamat.tracknow
